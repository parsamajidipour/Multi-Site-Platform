# Local ports
DEV_HTTP_PORT=8080
DEV_HTTPS_PORT=4443
HTTP_PORT=80

# Local public URLs used by the development proxy
DEV_MAIN_SITE_PUBLIC_URL=http://example.localhost:8080
DEV_REAL_ESTATE_PUBLIC_URL=http://real-estate.example.localhost:8080
DEV_FINANCE_PUBLIC_URL=http://finance.example.localhost:8080
DEV_VISA_PUBLIC_URL=http://visa.example.localhost:8080

# Frontend cross-site links and CMS base URL
VITE_MAIN_SITE_URL=http://example.localhost:8080
VITE_REAL_ESTATE_URL=http://real-estate.example.localhost:8080
VITE_FINANCE_URL=http://finance.example.localhost:8080
VITE_VISA_URL=http://visa.example.localhost:8080
VITE_CMS_API_URL=__SAME_ORIGIN__

# Development CMS database and Django settings.
# These are sample-only values for local containers, not production secrets.
CMS_POSTGRES_DB=rezaei_cms
CMS_POSTGRES_USER=rezaei_cms
CMS_POSTGRES_PASSWORD=rezaei_cms_dev_password
DATABASE_URL=postgres://rezaei_cms:rezaei_cms_dev_password@cms-db:5432/rezaei_cms
DJANGO_SECRET_KEY=dev-only-cms-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=cms.example.localhost,cms-api,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://admin.example.localhost:8080,http://example.localhost:8080,http://real-estate.example.localhost:8080,http://finance.example.localhost:8080,http://visa.example.localhost:8080
CSRF_TRUSTED_ORIGINS=http://cms.example.localhost:8080,http://admin.example.localhost:8080
CMS_SUPERUSER_USERNAME=dev-admin
CMS_SUPERUSER_EMAIL=dev-admin@example.localhost
CMS_SUPERUSER_PASSWORD=replace-with-dev-password

# Production URL placeholders. Replace these with your real domains.
MAIN_SITE_PUBLIC_URL=https://example.com
REAL_ESTATE_PUBLIC_URL=https://real-estate.example.com
FINANCE_PUBLIC_URL=https://finance.example.com
VISA_PUBLIC_URL=https://visa.example.com
ADMIN_PUBLIC_URL=https://admin.example.com
CMS_PUBLIC_URL=https://cms.example.com
FRONTEND_CMS_API_URL=__SAME_ORIGIN__

# Production CMS values. Set real secrets in your server .env; do not commit them.
# CMS_POSTGRES_DB=rezaei_cms
# CMS_POSTGRES_USER=rezaei_cms
# CMS_POSTGRES_PASSWORD=replace-with-strong-database-password
# DATABASE_URL=postgres://rezaei_cms:replace-with-strong-database-password@cms-db:5432/rezaei_cms
# DJANGO_SECRET_KEY=replace-with-long-random-secret
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=cms.example.com,admin.example.com,example.com,real-estate.example.com,finance.example.com,visa.example.com,cms-api
# CORS_ALLOWED_ORIGINS=https://admin.example.com,https://example.com,https://real-estate.example.com,https://finance.example.com,https://visa.example.com
# CSRF_TRUSTED_ORIGINS=https://cms.example.com,https://admin.example.com
# CMS_GUNICORN_WORKERS=3
# CMS_SUPERUSER_USERNAME=admin
# CMS_SUPERUSER_EMAIL=admin@example.com
# CMS_SUPERUSER_PASSWORD=replace-with-strong-admin-password
